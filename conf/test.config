/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/nanoseq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Basecall R10.4.1 (5 kHz) POD5 data with dorado, then align and QC
    // POD5 and reference: HG002 chr1:5-10 Mb subsets from the nf-core/methylong test data
    input                      = "${projectDir}/tests/samplesheets/samplesheet_bc_pod5.csv"
    fasta                      = params.pipelines_testdata_base_path + 'methylong/v2.0.0/test_data/test_pod5/chm13v2.0.Chr1_5MB-10MB.fasta'
    protocol                   = 'DNA'
    input_path_file_type       = 'pod5'
    dorado_model               = 'dna_r10.4.1_e8.2_400bps_fast@v5.2.0'
    dorado_device              = 'cpu'
    skip_demultiplexing        = true
    run_nanolyse               = true
    skip_quantification        = true
    skip_fusion_analysis       = true
    skip_modification_analysis = true
}
