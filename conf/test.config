/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nf-core/nanoseq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data to perform both basecalling and demultiplexing
    input               = params.pipelines_testdata_base_path + 'nanoseq/3.2/samplesheet/samplesheet_bc_dx.csv'
    fasta               = params.pipelines_testdata_base_path + 'nanoseq/reference/hg19_KCMF1.fa'
    protocol            = 'cDNA'
    flowcell            = 'FLO-MIN106'
    kit                 = 'SQK-DCS109'
    barcode_kit         = 'NBD103/NBD104'
    trim_barcodes       = true
    dorado_model        = 'dna_r10.4.1_e8.2_400bps_hac@v4.1.0'
    dorado_device       = 'cpu'
    run_nanolyse        = true
    skip_quantification = true
    skip_fusion_analysis= true
    skip_modification_analysis=true

    // This variable is just for reference and isnt actually required for the tests
    // Files are downloaded and staged using the "GetTestData" process
    input_path          = params.pipelines_testdata_base_path + 'nanoseq/fast5/barcoded_multi/'
}
