/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/nanoseq -profile test_nobc_dx,<docker/singularity> --outdir <OUTDIR>
 */

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data to perform demultipexing
    input               = params.pipelines_testdata_base_path + 'nanoseq/3.2/samplesheet/samplesheet_nobc_dx.csv'
    fasta               = params.pipelines_testdata_base_path + 'nanoseq/reference/chr22_23800000-23980000.fa'
    gtf                 = params.pipelines_testdata_base_path + 'nanoseq/reference/chr22_23800000-23980000.gtf'
    skip_basecalling    = true
    run_nanolyse        = true
    protocol            = 'DNA'
    barcode_kit         = 'NBD103/NBD104'
    input_path          = params.pipelines_testdata_base_path + 'nanoseq/fastq/nondemultiplexed/sample_nobc_dx.fastq.gz'
    skip_bigwig         = true
    skip_bigbed         = true
    skip_quantification = true
    skip_fusion_analysis= true
    skip_modification_analysis=true
}
