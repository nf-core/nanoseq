/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/nanoseq -profile test_bc_nodx,<docker/singularity> --outdir <OUTDIR>
 */

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check modified base calling with dorado and modkit'

    // Modified base calling (5mCG/5hmCG) of R10.4.1 (5 kHz) POD5 data with dorado,
    // alignment with dorado aligner and bedMethyl creation with modkit
    // POD5 and reference: HG002 chr1:5-7 Mb subset from the nf-core/methylong test data
    input                      = "${projectDir}/tests/samplesheets/samplesheet_bc_pod5_modbase.csv"
    fasta                      = params.pipelines_testdata_base_path + 'methylong/v2.0.0/test_data/test_pod5/chm13v2.0.Chr1_5MB-10MB.fasta'
    protocol                   = 'DNA'
    input_path_file_type       = 'pod5'
    bedmethyl_out              = true
    dorado_model               = 'dna_r10.4.1_e8.2_400bps_hac@v6.0.0'
    dorado_modification        = '5mCG_5hmCG'
    dorado_device              = 'cpu'
    skip_demultiplexing        = true
    skip_quantification        = true
    skip_fusion_analysis       = true
    skip_modification_analysis = true
}
