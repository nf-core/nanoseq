/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/nanoseq -profile test_bc_nodx,<docker/singularity> --outdir <OUTDIR>
 */

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data to perform basecalling and to skip demultipexing
    input               = params.pipelines_testdata_base_path + 'nanoseq/3.2/samplesheet/samplesheet_bc_nodx.csv'
    fasta               = params.pipelines_testdata_base_path + 'nanoseq/reference/hg19_KCMF1.fa'
    protocol            = 'cDNA'
    flowcell            = 'FLO-MIN106'
    kit                 = 'SQK-DCS108'
    dorado_model        = 'dna_r10.4.1_e8.2_400bps_hac@v4.1.0'
    dorado_device       = 'cpu'
    skip_bigbed         = true
    skip_bigwig         = true
    skip_demultiplexing = true
    skip_quantification = true
    skip_fusion_analysis= true
    skip_modification_analysis=true
}
