/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/nanoseq -profile test_nobc_nodx_rnamod,<docker/singularity> --outdir <OUTDIR>
 */

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data to skip demultiplexing and rna modification analysis
    input               = params.pipelines_testdata_base_path + 'nanoseq/3.2/samplesheet/samplesheet_nobc_nodx_rnamod.csv'
    fasta               = params.pipelines_testdata_base_path + 'nanoseq/reference/modification_transcriptome_subset.fa'
    gtf                 = params.pipelines_testdata_base_path + 'nanoseq/reference/modification_transcriptome_subset.gtf'
    skip_basecalling    = true
    protocol            = 'directRNA'
    run_nanolyse        = true
    skip_bigbed         = true
    skip_bigwig         = true
    skip_demultiplexing = true
    skip_quantification = true
    skip_fusion_analysis= true
}

