/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Input, test data and references
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'GET_TEST_DATA|GET_NANOLYSE_FASTA|GET_JAFFAL_REF|UNTAR|CUSTOM_GETCHROMSIZES' {
        publishDir = [ enabled: false ]
    }

    withName: SAMPLESHEET_CHECK {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Basecalling, demultiplexing and read cleaning
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: FAST5_TO_POD5 {
        publishDir = [ enabled: false ]
    }

    withName: 'DORADO_BASECALLER|DORADO_ALIGNER|MODKIT_PILEUP' {
        publishDir = [
            path: { "${params.outdir}/dorado" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: QCAT {
        ext.args = { [
            "--min-score ${params.qcat_min_score}",
            params.qcat_detect_middle ? '--detect-middle' : '',
            params.trim_barcodes      ? '--trim'          : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/qcat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: NANOLYSE {
        publishDir = [
            path: { "${params.outdir}/nanolyse" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Read QC
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: NANOPLOT {
        ext.args   = { "-p ${meta.id}_" }
        publishDir = [
            path: { "${params.outdir}/nanoplot/fastq/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: TOULLIGQC {
        publishDir = [
            path: { "${params.outdir}/toulligqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Alignment
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Spliced alignment is used for RNA data aligned to a genome (i.e. when a GTF is
        provided). DNA data or RNA data aligned to a transcriptome use unspliced presets.
    */

    withName: '.*:ALIGN_MINIMAP2:MINIMAP2_INDEX' {
        ext.args   = { [
            (params.protocol == 'DNA' || !params.gtf) ? '-x map-ont' : '-x splice',
            params.protocol == 'directRNA' ? '-k14' : ''
        ].join(' ').trim() }
        publishDir = [ enabled: false ]
    }

    withName: '.*:ALIGN_MINIMAP2:MINIMAP2_ALIGN' {
        ext.args   = { [
            (params.protocol == 'DNA' || !params.gtf) ? '-x map-ont' : '-x splice',
            params.protocol == 'directRNA' ? '-k14' : '',
            (params.stranded || params.protocol == 'directRNA') ? '-uf' : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/minimap2" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,bai}'
        ]
    }

    withName: '.*:ALIGN_GRAPHMAP2:GRAPHMAP2_INDEX' {
        ext.args   = { (params.protocol != 'DNA' && params.gtf) ? "-x rnaseq --gtf ${params.gtf}" : '' }
        publishDir = [ enabled: false ]
    }

    withName: '.*:ALIGN_GRAPHMAP2:GRAPHMAP2_ALIGN' {
        ext.args   = { [
            '--extcigar',
            (params.protocol != 'DNA' && params.gtf) ? "-x rnaseq --gtf ${params.gtf}" : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/graphmap2" },
            mode: params.publish_dir_mode,
            enabled: params.save_align_intermeds
        ]
    }

    withName: '.*:ALIGN_GRAPHMAP2:SAMTOOLS_SORT' {
        publishDir = [
            path: { "${params.outdir}/graphmap2" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,bai}'
        ]
    }

    withName: '.*:BAM_STATS_SAMTOOLS:.*' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/samtools_stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BAM_RENAME|NANOSEQ:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Coverage tracks
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: '.*:BEDTOOLS_UCSC_BIGWIG:BEDTOOLS_GENOMECOV' {
        ext.args   = { params.protocol == 'DNA' ? '-bg' : '-bg -split' }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigwig" },
            mode: params.publish_dir_mode,
            pattern: '*.bedGraph'
        ]
    }

    withName: '.*:BEDTOOLS_UCSC_BIGWIG:UCSC_BEDGRAPHTOBIGWIG' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigwig" },
            mode: params.publish_dir_mode,
            pattern: '*.bigWig'
        ]
    }

    withName: '.*:BEDTOOLS_UCSC_BIGBED:BEDTOOLS_BAMTOBED' {
        ext.args   = '-bed12 -cigar'
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigbed" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }

    withName: '.*:BEDTOOLS_UCSC_BIGBED:UCSC_BEDTOBIGBED' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/bigbed" },
            mode: params.publish_dir_mode,
            pattern: '*.bigBed'
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Quantification and differential analysis
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: BAMBU {
        publishDir = [
            path: { "${params.outdir}/bambu" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'STRINGTIE_STRINGTIE|STRINGTIE_MERGE' {
        publishDir = [
            path: { "${params.outdir}/stringtie2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SUBREAD_FEATURECOUNTS_GENE {
        ext.args   = '-L -O -f -g gene_id -t exon'
        publishDir = [
            path: { "${params.outdir}/stringtie2/featureCounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: SUBREAD_FEATURECOUNTS_TRANSCRIPT {
        ext.args   = '-L -O -f --primary --fraction -F GTF -g transcript_id -t transcript --extraAttributes gene_id'
        publishDir = [
            path: { "${params.outdir}/stringtie2/featureCounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DESEQ2|DEXSEQ' {
        publishDir = [
            path: { "${params.outdir}/${params.quantification_method}/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        RNA fusion and modification analysis
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: JAFFAL {
        publishDir = [
            path: { "${params.outdir}/jaffal" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NANOPOLISH_INDEX_EVENTALIGN|F5C_INDEX_EVENTALIGN' {
        publishDir = [
            path: { "${params.outdir}/rna_modifications/nanopolish" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: XPORE_DATAPREP {
        publishDir = [
            path: { "${params.outdir}/rna_modifications/xpore/dataprep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: XPORE_DIFFMOD {
        publishDir = [
            path: { "${params.outdir}/rna_modifications/xpore/diffmod" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: M6ANET_DATAPREP {
        publishDir = [
            path: { "${params.outdir}/rna_modifications/m6anet/dataprep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: M6ANET_INFERENCE {
        publishDir = [
            path: { "${params.outdir}/rna_modifications/m6anet/inference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        MultiQC
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
