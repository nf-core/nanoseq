nextflow_process {

    name "Test Process FAST5_TO_POD5"
    script "../../../modules/local/fast5_to_pod5.nf"
    process "FAST5_TO_POD5"

    tag "modules"
    tag "modules_local"
    tag "fast5_to_pod5"

    // FAST5 to POD5 conversion is independent of the sequencing chemistry, so the R9.4.1 FAST5
    // test data can be used even though current dorado releases cannot basecall it
    test("fast5 - barcoded R9.4.1") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + 'nanoseq/fast5/barcoded_multi/batch_0.fast5', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            // POD5 files embed a random file identifier, so check name and size rather than md5
            def pod5 = file(process.out.pod5[0][1])
            assertAll(
                { assert pod5.name == 'test.pod5' },
                { assert pod5.size() > 0 },
                { assert snapshot(
                    process.out.pod5.collect { meta, pod5_file -> [ meta, file(pod5_file).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }

    test("fast5 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'test' ],
                    file(params.pipelines_testdata_base_path + 'nanoseq/fast5/barcoded_multi/batch_0.fast5', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
